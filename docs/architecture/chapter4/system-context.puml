@startuml System_Context
!theme plain
top to bottom direction
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80
skinparam packageStyle rectangle

' Arrow styling
skinparam ArrowFontSize 12
skinparam ArrowFontStyle bold
skinparam ArrowFontColor #111111
skinparam ArrowColor #444444
skinparam ArrowThickness 1.5

actor "Bank Customer" as USER
actor "Bank Administrator" as ADMIN

package "CashTactics Platform" {
	rectangle "<<Software System>>\nCashTactics\nOnline Banking Platform\n\nSpring Boot Microservices + React SPA\nAPI Gateway (Spring Cloud Gateway)\n6 backend microservices,\nPostgreSQL with 6 isolated schemas" as SYSTEM #438DD5
}

package "External Systems" {
	rectangle "<<External System>>\nStripe\nPayment Processing" as STRIPE #gray
	rectangle "<<External System>>\nEuropean Central Bank\nExchange Rates API" as ECB #gray
}

USER --> SYSTEM : "Manages accounts, transfers\n& card top-ups\n[HTTPS / Browser]"

ADMIN --> SYSTEM : "Reviews fraud alerts,\nmanages clients, GDPR\n[HTTPS / Browser]"

SYSTEM --> STRIPE : "Card top-ups & webhooks\n[HTTPS / Stripe API]"

SYSTEM --> ECB : "Daily exchange rates\n[HTTPS / XML]"

@enduml
