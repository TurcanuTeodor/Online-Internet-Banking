@startuml Transfer_Flow
!theme plain
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam sequenceMessageAlign center

title Figure 4.6 — Transfer Flow Sequence

actor "User" as USER
participant "Frontend\n(React)" as FE
participant "API Gateway\n:8443" as GW
participant "Account Service\n:8083" as ACC
participant "Auth Service\n:8081" as AUTH
participant "Fraud Service\n:8086" as FRAUD
participant "Transaction Service\n:8084" as TX

== Transfer Initiation ==
USER -> FE : Click "Transfer"\n(fromIban, toIban, amount, [totpCode])
FE -> GW : POST /api/accounts/transfer\n[Authorization: Bearer <JWT>]
GW -> GW : Validate JWT\n(signature + blacklist check)
GW -> ACC : Forward request + JWT

== Validation & Lock Acquisition ==
ACC -> ACC : Validate accounts exist
ACC -> ACC : Check account ownership (clientId)
ACC -> ACC : Check sufficient balance
ACC -> ACC : Acquire Redisson distributed locks\n(alphabetical IBAN order — deadlock-safe)

== Fraud Check (Synchronous — Tier 1 Rules) ==
ACC -> FRAUD : POST /api/internal/fraud/evaluate\n[X-Internal-Api-Secret]\n{accountId, clientId, amount, senderIban, receiverIban,\ntransactionType, selfTransfer, accountAgeDays, ...}

FRAUD -> FRAUD : Self-transfer? → auto-ALLOW

FRAUD -> FRAUD : Tier 1 Rule Engine:\n- LARGE_AMOUNT (> 10,000)?\n- BURST (≥ 5 evaluations/60s for account)?\n- NEW_ACCOUNT + HIGH_AMOUNT (< 30d, > 2000)?

alt Tier 1: STEP_UP_REQUIRED (rule triggered)
  note right of FRAUD
    Tier 1 never returns BLOCK in practice.
    Rules return ALLOW or STEP_UP_REQUIRED.
  end note
  FRAUD -> FRAUD : Skip Tier 2 (already need step-up)
else Tier 1: ALLOW or MANUAL_REVIEW
  == Fraud Check (Synchronous — Tier 2 Behavioral Scoring) ==
  FRAUD -> TX : GET /api/internal/transactions/by-account/{id}\n[X-Internal-Api-Secret]
  TX --> FRAUD : Transaction history
  FRAUD -> FRAUD : Recompute UserBehaviorProfile\n(avg amount, frequency, typical hours,\ncommon IBANs, velocity)
  FRAUD -> FRAUD : Compute composite risk score:\n0.30*S_amount + 0.20*S_freq + 0.15*S_time\n+ 0.15*S_recipient + 0.10*S_cat + 0.10*S_vel
  FRAUD -> FRAUD : Map score → status:\n< 50 → ALLOW\n50-70 → STEP_UP_REQUIRED\n≥ 70 → FLAG
end

FRAUD --> ACC : {decisionId, status, riskScore, explanation}

== Step-Up Authentication (if required) ==
alt Fraud status == STEP_UP_REQUIRED OR amount ≥ large-transfer-threshold
  alt totpCode provided
    ACC -> AUTH : POST /api/internal/auth/step-up\n[X-Internal-Api-Secret]\n{clientId, totpCode}
    alt TOTP valid
      AUTH --> ACC : 200 OK
    else TOTP invalid
      AUTH --> ACC : 401 Unauthorized
      ACC --> GW : 428 Precondition Required
      GW --> FE : 428 error
      FE --> USER : "Please enter 2FA code"
    end
  else totpCode missing
    ACC --> GW : 428 Precondition Required
    GW --> FE : 428 error
    FE --> USER : "This transaction requires 2FA"
  end
else Fraud status == FLAG
  note right of ACC
    FLAG means: transfer proceeds but
    decision recorded for admin review.
  end note
else Fraud status == BLOCK (only if fraud service explicitly blocks)
  ACC --> GW : 422 BusinessRuleViolation
  GW --> FE : 422 error
  FE --> USER : "Transaction blocked"
end

== Balance Update ==
ACC -> ACC : Apply ECB exchange rate if currencies differ
ACC -> ACC : sender.balance -= amount
ACC -> ACC : receiver.balance += convertedAmount
ACC -> ACC : Save both accounts (@Transactional)
ACC -> ACC : Publish Redis cache invalidation events\n(cache:account:invalidate channel)

== Transaction Records (JWT forwarded) ==
ACC -> TX : POST /api/transactions\n[JWT]\n{sender debit, sign: "-"}
TX --> ACC : 201 Created

ACC -> TX : POST /api/transactions\n[JWT]\n{receiver credit, sign: "+"}
TX --> ACC : 201 Created

ACC -> ACC : Release Redisson locks (finally block)

ACC --> GW : 200 OK
GW --> FE : Transfer successful
FE --> USER : "Transfer complete"

== Asynchronous Fraud Analysis (Non-blocking, background thread) ==
note over ACC, FRAUD
  If final status == ALLOW, fraud-service schedules Tier 3 ML analysis
  in the fraudAsyncExecutor thread pool (does NOT delay response above).
  See Figure 4.7 — Async Tier 3 ML Analysis.
end note

@enduml
